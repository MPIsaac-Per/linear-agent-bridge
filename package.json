{
  "name": "linear-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge Linear agent sessions to a local agent runtime",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run native:build",
    "dev": "tsx src/index.ts",
    "prebuild": "npm run native:build",
    "build": "tsc",
    "prestart": "npm run native:build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run native:build",
    "test": "vitest run",
    "test:install": "bash -n deploy/install.sh deploy/install.test.sh && bash deploy/install.test.sh",
    "pretest:watch": "npm run native:build",
    "test:watch": "vitest",
    "native:build": "node scripts/build-native.mjs",
    "native:check": "node scripts/build-native.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
