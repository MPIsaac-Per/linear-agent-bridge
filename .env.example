# Linear OAuth application (Settings -> API -> Applications -> new)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Webhook signing secret shown in the app's webhook section
LINEAR_WEBHOOK_SECRET=
# Bootstrap access token. The OAuth callback stores the rotating access and
# refresh tokens in OAUTH_TOKEN_STORE_PATH after the first authorization.
# Set any placeholder before the install flow so the service can boot.
LINEAR_ACCESS_TOKEN=
OAUTH_TOKEN_STORE_PATH=./data/oauth-tokens.json

# HTTP server
PORT=3979

# Agent runtime: claude | codex (codex is an unimplemented stub)
RUNTIME=claude
# Directory agent sessions run in. Point this at the repo or knowledge base
# whose CLAUDE.md/MCP context the agent should carry. Defaults to the
# service's working directory.
KB_PATH=
# Where linear-session -> runtime-session mappings persist
SESSION_STORE_PATH=./data/sessions.json
# Durable webhook receipts, semantic execution claims, and caller-generated
# Linear activity UUIDs. Marker-free accepted turns also carry a short-lived,
# encrypted recovery envelope. Keep this on persistent local storage.
BRIDGE_STATE_STORE_PATH=./data/bridge-state.json
# Required 32-byte base64url key for ingress recovery envelopes. Generate with:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
INGRESS_RECOVERY_KEY=
# During rotation, retain up to four older keys as a comma-separated list with
# no spaces. New envelopes use INGRESS_RECOVERY_KEY; recovery reads all keys.
INGRESS_RECOVERY_PREVIOUS_KEYS=

# Stop a run after this long without runtime progress. Active runs have no
# wall-clock cap, and stop signals still cancel immediately.
RUN_INACTIVITY_TIMEOUT_MS=300000
# Deprecated one-release fallback. Its presence logs one bounded warning:
# RUN_TIMEOUT_MS=300000
